# =============================================================================
# PAC UFPI — Variáveis de Ambiente de Exemplo (.env.example)
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.
# =============================================================================

# -----------------------------------------------------------------------------
# Configurações do Django / Aplicação
# -----------------------------------------------------------------------------
# Gere uma chave forte e única para produção: python -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=sua-chave-secreta-forte-aqui
DJANGO_DEBUG=False
PAC_ENVIRONMENT=development

# Hosts autorizados (separados por vírgula)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,pac_backend,frontend,pac_frontend,0.0.0.0

# Origens confiáveis para CSRF e CORS (separadas por vírgula)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:80,http://localhost:8000,http://127.0.0.1,http://127.0.0.1:80,http://127.0.0.1:8000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# Banco de Dados PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=pac_db
POSTGRES_USER=pac_user
POSTGRES_PASSWORD=pac_password_segura

# String de conexão do banco (utilizada pelo Django)
# No Docker Compose, o hostname é o nome do serviço 'db'
DATABASE_URL=postgres://pac_user:pac_password_segura@db:5432/pac_db

# -----------------------------------------------------------------------------
# Portas de Exposição no Host
# -----------------------------------------------------------------------------
# Porta de entrada principal da aplicação Web (Nginx / Frontend)
PORT=80

# -----------------------------------------------------------------------------
# Interface Gráfica pgAdmin 4 (Opcional / Gerenciamento)
# -----------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@pac.ufpi.br
PGADMIN_DEFAULT_PASSWORD=admin_pac_segura
PGADMIN_PORT=5050

# -----------------------------------------------------------------------------
# Configurações de E-mail (Opcional)
# -----------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Dados de Homologação (Seed — Opcional / Testes)
# -----------------------------------------------------------------------------
# Obrigatória apenas ao executar `python manage.py seed_homologacao`.
HOMOLOGACAO_TEST_PASSWORD=
# Trava explícita: mantenha False fora de development/homologation.
ALLOW_HOMOLOGACAO_SEED=False
# Obrigatória para banco remoto. Aceita fingerprints separados por vírgula.
HOMOLOGACAO_SEED_REMOTE_FINGERPRINTS=
