# =============================================================================
# Configurações do Django / Aplicação
# =============================================================================
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=False
PAC_ENVIRONMENT=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,app,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000

# =============================================================================
# Banco de dados e Docker Compose
# =============================================================================
POSTGRES_DB=pac_db
POSTGRES_USER=pac_user
POSTGRES_PASSWORD=pac_password
POSTGRES_PORT=5432
PORT=8000

# Conexão direta ou usada fora do Docker Compose
DATABASE_URL=postgres://pac_user:pac_password@db:5432/pac_db
FRONTEND_URL=http://localhost:8000

# =============================================================================
# Interface Gráfica pgAdmin 4
# =============================================================================
PGADMIN_DEFAULT_EMAIL=admin@pac.ufpi.br
PGADMIN_DEFAULT_PASSWORD=admin_pac
PGADMIN_PORT=5050


# =============================================================================
# E-mail
# =============================================================================
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# =============================================================================
# Dados de Homologação (Seed)
# =============================================================================
# Obrigatória apenas ao executar `python manage.py seed_homologacao`.
# Defina uma senha temporária no ambiente de homologação; não versione o valor.
HOMOLOGACAO_TEST_PASSWORD=
# Trava explícita: mantenha False fora de development/homologation.
ALLOW_HOMOLOGACAO_SEED=False
# Obrigatória para banco remoto. Aceita fingerprints separados por vírgula.
HOMOLOGACAO_SEED_REMOTE_FINGERPRINTS=
